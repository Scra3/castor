{
  "author": "",
  "bin": "./bin/run.js",
  "dependencies": {
    "@forestadmin/agent-client": "^1.6.3",
    "@inquirer/prompts": "^7",
    "@oclif/core": "^3",
    "@oclif/plugin-help": "^6",
    "yaml": "^2.9.0"
  },
  "description": "castor — construis ton Forest avec ton compagnon castor 🦫",
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^3",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^8",
    "eslint-config-oclif": "^5",
    "eslint-config-oclif-typescript": "^3",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10",
    "oclif": "^4.3.6",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/Scra3/castor",
  "license": "MIT",
  "main": "",
  "name": "castor",
  "oclif": {
    "bin": "castor",
    "dirname": "castor",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "agent": {
        "description": "Query and drive a running agent: read, create, update and delete records, run smart actions and charts."
      },
      "layout": {
        "description": "Edit the layout file: pull/diff/apply/patch (atomic per domain)."
      },
      "workflow": {
        "description": "Drive the workflow engine orchestrator: start, resume and run the lifecycle of workflow executions (orchestrator engine only)."
      }
    },
    "topicSeparator": " "
  },
  "repository": "Scra3/castor",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "yarn lint",
    "prepack": "yarn build && oclif manifest && oclif readme",
    "prepare": "yarn build",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "version": "0.0.0",
  "bugs": "https://github.com/Scra3/castor/issues",
  "keywords": [
    "oclif",
    "castor",
    "forest-admin"
  ],
  "types": "dist/index.d.ts",
  "exports": "./lib/index.js",
  "type": "module"
}
